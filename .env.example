# ============================================================
# AI WORLD — environment configuration
# Copy to .env and fill in what you need:  cp .env.example .env
# NEVER commit .env. Keys live only on the backend/worker side.
# ============================================================

# ---- Runtime ------------------------------------------------
ENVIRONMENT=development            # development | production
LOG_LEVEL=INFO
LOG_FORMAT=json                    # json | text

# ---- Infrastructure ----------------------------------------
POSTGRES_USER=aiworld
POSTGRES_PASSWORD=aiworld
POSTGRES_DB=aiworld
DATABASE_URL=postgresql+asyncpg://aiworld:aiworld@postgres:5432/aiworld
REDIS_URL=redis://redis:6379/0

# ---- LLM providers (leave empty to disable a provider) ------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_DEFAULT_MODEL=claude-haiku-4-5

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_DEFAULT_MODEL=gemini-3.8-flash
# Tried in order when the main model is overloaded (503/429) or retired (404).
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite

# Local models through Ollama, e.g. http://host.docker.internal:11434
OLLAMA_BASE_URL=
OLLAMA_DEFAULT_MODEL=llama3.1:8b

# Order in which providers are tried when an agent's own provider fails.
LLM_FALLBACK_CHAIN=openai,anthropic,gemini,ollama
# When no real provider is reachable, fall back to the built-in offline
# simulation engine ("sim") so the world keeps living. Set false to make
# agents go temporarily_unavailable instead.
ALLOW_SIM_FALLBACK=true

LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=400
LLM_MAX_CALLS_PER_AGENT_PER_HOUR=40
LLM_GLOBAL_CALLS_PER_MINUTE=60
LLM_DAILY_BUDGET_USD=2.0
# Let the LLM choose chess/tic-tac-toe moves and quiz answers (costs more).
GAME_MOVES_USE_LLM=false

# ---- Research mode -----------------------------------------
# true = agents are free: no style rules ("be brief", "wrap up"), any action in any room,
# no cooldowns / talk-rate / energy blocking, every wake-up is a real LLM decision,
# messages up to 4000 chars, open-ended "do" and "create_place" actions.
# The sandbox stays: agents still cannot run code, read files, reach the internet or see keys.
# Recommended together with: ALLOW_SIM_FALLBACK=false, LLM_MAX_OUTPUT_TOKENS=1500,
# and budgets that match your wallet (LLM_DAILY_BUDGET_USD, LLM_MAX_CALLS_PER_AGENT_PER_HOUR).
RESEARCH_MODE=false

# Embeddings for semantic memory: auto | openai | gemini | ollama | hash
EMBEDDING_PROVIDER=auto
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ---- Scheduler / world simulation --------------------------
SCHEDULER_TICK_SECONDS=1.0
SCHEDULER_CONCURRENCY=4
AGENT_MIN_WAKE_SECONDS=6
AGENT_MAX_WAKE_SECONDS=90
# World clock speed: 1 real minute = N world minutes.
WORLD_TIME_SCALE=6

# ---- Auth / API --------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-please-use-a-long-random-secret
JWT_EXPIRE_MINUTES=10080
ADMIN_EMAIL=admin@aiworld.local
ADMIN_PASSWORD=change-me-admin
CORS_ORIGINS=http://localhost:3000
API_RATE_LIMIT_PER_MINUTE=120
AUTO_SEED=true

# ---- Frontend (public values only — never put secrets here) -
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
# Used by the Next.js server to reach the backend inside Docker.
INTERNAL_API_URL=http://backend:8000
