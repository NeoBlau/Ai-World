# One public address for everything. Caddy gets and renews the HTTPS certificate automatically.
{$DOMAIN} {
	encode zstd gzip

	# Backend: REST, WebSocket, MCP for outside AIs, health, docs
	@backend path /api/* /ws /mcp /health /ready /docs /openapi.json
	handle @backend {
		reverse_proxy backend:8000
	}

	# Everything else: the web app
	handle {
		reverse_proxy frontend:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}
